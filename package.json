{
  "name": "atlas-ops-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "Executive AI Operations Assistant: a chat agent that actually calls tools (schedule, tasks, email drafts, document summaries) via a hand-rolled, provider-agnostic reasoning loop, instead of just talking.",
  "license": "MIT",
  "author": "ubaidslab",
  "repository": {
    "type": "git",
    "url": "https://github.com/ubaidslab/Executive-AI-Operations-Assistant.git"
  },
  "keywords": [
    "ai",
    "agent",
    "tool-calling",
    "executive-assistant",
    "operations",
    "nextjs",
    "typescript"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx lib/db/migrate.ts",
    "db:seed": "tsx lib/db/seed.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.427.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^2.4.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
