# Copy this file to .env.local and fill in the values you need.
# .env.local is git-ignored — never commit real secrets.

# ---------------------------------------------------------------------------
# Database — local SQLite file by default, zero external account needed.
# ---------------------------------------------------------------------------
DATABASE_URL=file:./local.db
# Only needed if DATABASE_URL points at a remote Turso database instead.
DATABASE_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# AI_PROVIDER selects which LLM backend powers the agent loop.
# Default: cloudflare
# ---------------------------------------------------------------------------
AI_PROVIDER=cloudflare

# --- Cloudflare Workers AI (default provider) -------------------------------
# Free tier available: https://developers.cloudflare.com/workers-ai/
# Pick a model that supports instruction-following well enough to reliably
# emit the JSON action format the agent loop expects (see README).
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_KEY=your_cloudflare_api_token
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# --- OpenAI (optional, set AI_PROVIDER=openai to use it) --------------------
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Public URL of your deployment, used for social preview (Open Graph) images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
